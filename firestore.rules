rules_version = '2';

// Ascend: each signed-in person can read and write their own documents and
// nothing else. Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function stamped(d) {
      return d.updatedAt is number && d.updatedAt >= 0;
    }

    // A deleted session stays as a tombstone so the deletion reaches every device.
    function validTombstone(d) {
      return d.keys().hasOnly(['deleted', 'updatedAt']) && d.deleted == true && stamped(d);
    }

    function validSession(d) {
      return d.keys().hasOnly(['date', 'dayId', 'sets', 'xp', 'updatedAt', 'deleted'])
        && d.deleted == false && stamped(d)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.dayId is string && d.dayId.size() <= 4
        && d.sets is map && d.sets.size() <= 30
        && d.xp is number && d.xp >= 0 && d.xp <= 100000;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['startXp', 'weightKg', 'body', 'weights', 'rest', 'starts', 'updatedAt'])
        && stamped(d)
        && d.startXp is number && d.startXp >= 0 && d.startXp <= 10000000
        && (d.weightKg == null || d.weightKg is number)
        && d.weights is list && d.weights.size() <= 2000
        && d.rest is map && d.rest.size() <= 200
        && d.starts is map && d.starts.size() <= 200
        && (!('body' in d) || (d.body is map && d.body.size() <= 10));
    }

    match /users/{uid}/sessions/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && id.matches('^[A-Za-z0-9_-]{1,64}$')
        && (validSession(request.resource.data) || validTombstone(request.resource.data));
      allow delete: if false;
    }

    match /users/{uid}/meta/profile {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validProfile(request.resource.data);
      allow delete: if false;
    }
  }
}
